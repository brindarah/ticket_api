generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum Role {
  SUPER_ADMIN
  USER
}

enum UserStatus {
  INVITED
  ACTIVE
  DISABLED
}

model Ticket {
  id          String       @id @default(uuid())
  title       String
  description String
  status      TicketStatus @default(OPEN)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  // Auteur du ticket, déterminé par le JWT (jamais fourni par le client)
  createdById String
  createdBy   User         @relation(fields: [createdById], references: [id], onDelete: Restrict)

  @@index([createdById])
}

model User {
  id        String     @id @default(uuid())
  nom       String
  prenom    String
  email     String     @unique
  password  String?    // vide tant que l'invitation n'est pas acceptée
  role      Role       @default(USER)
  status    UserStatus @default(INVITED)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  refreshTokens       RefreshToken[]
  passwordResetTokens PasswordResetToken[]
  invitations         Invitation[]
  tickets             Ticket[]
  auditLogs           AuditLog[]
}

model RefreshToken {
  id        String    @id @default(uuid())
  tokenHash String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  revokedAt DateTime? // rempli quand le token est révoqué
  createdAt DateTime  @default(now())
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  tokenHash String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime? // rempli quand le token a servi
  createdAt DateTime  @default(now())
}

model Invitation {
  id        String    @id @default(uuid())
  tokenHash String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
}

enum AuditAction {
  SUPER_ADMIN_CREATED
  USER_DISABLED
  USER_REACTIVATED
  TICKET_STATUS_CHANGED
}

enum AuditEntityType {
  USER
  TICKET
}

// Trace des actions sensibles. Ne contient jamais de mot de passe, jeton ou secret.
model AuditLog {
  id         String          @id @default(uuid())
  // Auteur de l'action, déterminé côté serveur. null : action système (seed)
  actorId    String?
  actor      User?           @relation(fields: [actorId], references: [id], onDelete: Restrict)
  action     AuditAction
  entityType AuditEntityType
  entityId   String          // id de l'entité concernée (User ou Ticket)
  oldValue   Json?
  newValue   Json?
  createdAt  DateTime        @default(now())

  @@index([entityType, entityId])
  @@index([actorId])
  @@index([createdAt])
}
