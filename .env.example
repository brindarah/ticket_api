# Copier ce fichier en .env puis remplacer les valeurs fictives.
# Ne jamais committer le fichier .env.

DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/ticket_api?schema=public"
PORT=3000

# Resend : envoi des emails transactionnels (invitations, réinitialisation du mot de passe)
# Clé API créée dans le tableau de bord Resend. Elle commence par re_
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxx"
# Expéditeur : "Nom <adresse>" ou "adresse"
# onboarding@resend.dev sert uniquement aux tests : il n'envoie qu'à l'adresse du compte Resend.
# En production, utiliser une adresse d'un domaine vérifié dans Resend.
EMAIL_FROM="Ticket API <onboarding@resend.dev>"
