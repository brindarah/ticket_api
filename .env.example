# Copier ce fichier en .env puis remplacer les valeurs fictives.
# Ne jamais committer le fichier .env.

# --- Serveur et base de données ---
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/ticket_api?schema=public"
PORT=3000

# --- Authentification (JWT) ---
# Obligatoire : secret de signature des access tokens. Générer une valeur longue et aléatoire :
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET="remplacer-par-une-longue-valeur-aleatoire"
# Facultatif : durée de vie d'un access token (défaut : 15m)
JWT_ACCESS_EXPIRES_IN="15m"
# Facultatif : durée de vie d'un refresh token, en jours (défaut : 7)
REFRESH_TOKEN_DAYS=7

# --- Super Admin initial (utilisé uniquement par le seed : npx tsx prisma/seed.ts) ---
SUPER_ADMIN_EMAIL="admin@example.com"
SUPER_ADMIN_PASSWORD="remplacer-par-un-mot-de-passe-solide"

# --- Resend : emails transactionnels (invitations, réinitialisation du mot de passe) ---
# Clé API créée dans le tableau de bord Resend. Elle commence par re_
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxx"
# Expéditeur : "Nom <adresse>" ou "adresse"
# onboarding@resend.dev sert uniquement aux tests : il n'envoie qu'à l'adresse du compte Resend.
# En production, utiliser une adresse d'un domaine vérifié dans Resend.
EMAIL_FROM="Ticket API <onboarding@resend.dev>"

# Facultatif : URL publique de l'API, affichée dans les emails (invitation, réinitialisation).
# Il n'y a pas de frontend : les emails indiquent la requête API à envoyer.
# Sans cette variable, les emails indiquent seulement le chemin (ex. /auth/accept-invitation).
API_PUBLIC_URL="http://localhost:3000"
