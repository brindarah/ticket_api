DATABASE_URL="postgresql://ticket_user:ticket_pass@localhost:5432/ticket_db"
PORT=3000

# Générer avec : node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
REFRESH_TOKEN_DAYS=7

# Premier compte, créé avec : npx tsx prisma/seed.ts
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=

# Clé à créer sur resend.com (API Keys, Sending access)
RESEND_API_KEY=
EMAIL_FROM=onboarding@resend.dev

# Adresse du front, utilisée dans le lien de l'email de reset
FRONTEND_URL=http://localhost:5173